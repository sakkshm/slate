# Application Configuration
API_DEV_PORT=8080
API_PROD_PORT=8081
APP_INTERNAL_PORT=8080
APP_ENV_DEV=development
APP_ENV_PROD=production

# Site / Deployment URL Configuration
BUILD_TIMEOUT=600
SITE_BASE_DOMAIN=slate.dev
SITE_SCHEME=https
SITE_PORT=443
# Reserved subdomains never treated as deployments (comma-separated)
SITE_RESERVED_HOSTS=api,www,app,dashboard,admin,minio,docs,git,status

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=slate
POSTGRES_PORT=5432
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable

# GitHub Configuration (create a GitHub App; see docs/deploy.md)
GITHUB_CLIENT_ID=your-github-app-client-id
GITHUB_CLIENT_SECRET=your-github-app-client-secret
GITHUB_APP_SLUG=your-github-app-slug
GITHUB_APP_ID=your-github-app-id
# Secret used to sign the X-Hub-Signature-256 header on webhook deliveries
GITHUB_WEBHOOK_SECRET=generate-a-long-random-string
GITHUB_PRIVATE_KEY_PATH="./slate-private-key.pem"

# Encryption + Auth
# Both must be unique random values. ENCRYPTION_KEY encrypts env vars at rest.
ENCRYPTION_KEY=64-hex-characters
JWT_SECRET=64-random-characters

# Redis Configuration
REDIS_PORT=6379
# Leave empty for no auth, or set REDIS_PASSWORD and redeploy with a secure config
REDIS_PASSWORD=

# MinIO Configuration
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=generate-a-long-random-string
MINIO_BUCKET=slate-assets

# Security: CORS / rate limiting (prod hardening)
# Comma-separated list of origins allowed to call the API. Must include the
# frontend origin exactly (scheme, host, port).
CORS_ALLOWED_ORIGINS=https://slate.dev
# REQUIRED if a reverse proxy (Caddy/Traefik/nginx) terminates TLS in front of
# the API: list the proxy's CIDR ranges (e.g. 10.0.0.0/8,127.0.0.1/32) so rate
# limits key off the real client IP. Without this, every client shares the
# proxy's IP and the per-IP limits collapse into one global bucket.
TRUSTED_PROXY_IPS=
# Rate limits
RATE_GLOBAL_RPS=50      # max API requests/sec per client IP
RATE_AUTH_RPM=10        # max OAuth initiate/callback per minute per IP
RATE_WEBHOOK_RPM=100    # max webhook deliveries per minute per IP (generous for GitHub retries)
RATE_BUILD_RPH=10       # max build triggers per hour per user
